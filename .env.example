# GitHub identity & token (if GITHUB_TOKEN is empty, falls back to `gh auth token`)
GITHUB_USERNAME=markankamaransheogarat-sys
GITHUB_TOKEN=

# Drips Wave Program ID (Stellar Wave default)
WAVE_PROGRAM_ID=fdc01c95-806f-4b6a-998b-a6ed37e0d81b

# Radar scanning & filtering
SCAN_INTERVAL_SECONDS=45
ONLINE_WINDOW_MINUTES=15
MIN_POINTS=200
MAX_PENDING_APPS=0
STALE_HOURS=18
MAX_CANDIDATES_PER_REPO=4
HTTP_TIMEOUT_SECONDS=8.0

# Built-in Web Dashboard
WEB_HOST=127.0.0.1
WEB_PORT=8787

# Optional Telegram notifications (leave empty to use Web UI + console only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PROXY_URL=

# Logging
LOG_FILE=radar.log
LOG_LEVEL=INFO
